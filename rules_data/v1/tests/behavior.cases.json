  "boundary_cases": [
    {"id": "negative_source_count", "facts": {"advantage_sources": -1, "disadvantage_sources": 0}, "expected": {"reject": "invalid_context"}},
    {"id": "missing_disadvantage_count", "facts": {"advantage_sources": 1}, "expected": {"reject": "unknown_fact"}},
    {"id": "cannot_change_both_dice", "facts": {"roll_mode": "advantage", "die_change_authorized": true}, "choices": [0, 1], "expected": {"reject": "one_die_only"}},
    {"id": "reroll_does_not_authorize_replace", "authorization": {"kind": "reroll"}, "requested_change": "replace", "expected": {"reject": "authorization_mismatch"}},
    {"id": "poisoned_cancels_advantage", "kind": "check", "hero_conditions": ["poisoned"], "engine_arguments": {"advantage": true, "disadvantage": false}, "normalized_facts": {"advantage_sources": 1, "disadvantage_sources": 1}, "dice_queue": [8], "expected": {"matching_rule": "dnd2024.d20.cancellation", "count": 1, "selected": 8, "mode": "обычный"}}
  ]
