{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solo-realms-ai:adjudication:2.0.0",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$", "maxLength": 160},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "short_text": {"type": "string", "minLength": 1, "maxLength": 2000},
    "ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["message_type", "contract_version", "request_id", "state_version", "rules_family", "ruleset_digest", "context_hash", "question", "facts", "rules", "choices", "allowed_entities", "allowed_predicates"],
      "properties": {
        "message_type": {"const": "adjudication_request"}, "contract_version": {"const": "2.0.0"},
        "request_id": {"$ref": "#/$defs/id"}, "state_version": {"type": "integer", "minimum": 0}, "rules_family": {"const": "dnd2024"},
        "ruleset_digest": {"$ref": "#/$defs/hash"}, "context_hash": {"$ref": "#/$defs/hash"}, "question": {"$ref": "#/$defs/short_text"},
        "facts": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["id", "value"], "properties": {"id": {"$ref": "#/$defs/id"}, "value": {"type": ["string", "integer", "boolean", "null"], "maxLength": 1000}}}},
        "rules": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["id", "source_sha256", "pdf_page", "excerpt"], "properties": {"id": {"$ref": "#/$defs/id"}, "source_sha256": {"$ref": "#/$defs/hash"}, "pdf_page": {"type": "integer", "minimum": 1}, "excerpt": {"$ref": "#/$defs/short_text"}}}},
        "choices": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["id", "meaning"], "properties": {"id": {"$ref": "#/$defs/id"}, "meaning": {"$ref": "#/$defs/short_text"}}}},
        "allowed_entities": {"$ref": "#/$defs/ids"},
        "allowed_predicates": {"type": "array", "maxItems": 4, "uniqueItems": true, "items": {"enum": ["intent", "motive", "interpretation", "attitude_description"]}}
      }
    },
    "response": {
      "type": "object", "additionalProperties": false,
      "required": ["message_type", "contract_version", "request_id", "state_version", "rules_family", "ruleset_digest", "context_hash", "status", "choice_ids", "proposals", "fact_ids", "rule_ids", "rationale", "uncertainties"],
      "properties": {
        "message_type": {"const": "adjudication_response"}, "contract_version": {"const": "2.0.0"},
        "request_id": {"$ref": "#/$defs/id"}, "state_version": {"type": "integer", "minimum": 0}, "rules_family": {"const": "dnd2024"},
        "ruleset_digest": {"$ref": "#/$defs/hash"}, "context_hash": {"$ref": "#/$defs/hash"},
        "status": {"enum": ["decided", "needs_clarification", "unsupported"]},
        "choice_ids": {"$ref": "#/$defs/ids"},
        "proposals": {"type": "array", "maxItems": 8, "items": {"type": "object", "additionalProperties": false, "required": ["entity_id", "predicate", "text"], "properties": {"entity_id": {"$ref": "#/$defs/id"}, "predicate": {"enum": ["intent", "motive", "interpretation", "attitude_description"]}, "text": {"$ref": "#/$defs/short_text"}}}},
        "fact_ids": {"$ref": "#/$defs/ids"}, "rule_ids": {"$ref": "#/$defs/ids"}, "rationale": {"$ref": "#/$defs/short_text"},
        "uncertainties": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/short_text"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "decided"}}}, "then": {"properties": {"rule_ids": {"minItems": 1}, "uncertainties": {"maxItems": 0}}, "anyOf": [{"properties": {"choice_ids": {"minItems": 1}}}, {"properties": {"proposals": {"minItems": 1}}}]}, "else": {"properties": {"choice_ids": {"maxItems": 0}, "proposals": {"maxItems": 0}}}}
      ]
    }
  }
}
