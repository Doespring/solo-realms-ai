{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:solo-realms-ai:coverage:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rules_schema_version",
    "document_id",
    "chapter",
    "pdf_range",
    "extraction_complete",
    "execution_complete",
    "rule_count",
    "bookmarks",
    "subsections",
    "rules",
    "adapter_rule_ids",
    "external_dependencies",
    "unaccounted_bookmarks",
    "evidence",
    "classification_counts",
    "readiness_counts",
    "batches",
    "exclusions",
    "next",
    "notes",
    "verification_report"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "rules_schema_version": {
      "const": "2.1.0"
    },
    "document_id": {
      "const": "phb_2024_ru"
    },
    "chapter": {
      "const": 1
    },
    "pdf_range": {
      "const": [
        8,
        33
      ]
    },
    "extraction_complete": {
      "type": "boolean"
    },
    "execution_complete": {
      "type": "boolean"
    },
    "rule_count": {
      "type": "integer",
      "minimum": 1
    },
    "bookmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "pdf_page",
          "depth",
          "rule_ids"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "depth": {
            "type": "integer",
            "minimum": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^dnd2024\\.[a-z0-9_.]+$"
            }
          }
        }
      }
    },
    "subsections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "pdf_page",
          "rule_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^dnd2024\\.[a-z0-9_.]+$"
            }
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "file",
          "classification",
          "dependencies",
          "handler",
          "test_id",
          "pytest_node",
          "test_kind",
          "status",
          "pdf_pages"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^dnd2024\\.[a-z0-9_.]+$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "deterministic",
              "adjudicated",
              "hybrid"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "handler": {
            "type": [
              "string",
              "null"
            ]
          },
          "test_id": {
            "type": "string",
            "minLength": 1
          },
          "pytest_node": {
            "type": "string",
            "minLength": 1
          },
          "test_kind": {
            "enum": [
              "formal_behavior",
              "activation_refusal",
              "proposal_boundary"
            ]
          },
          "status": {
            "enum": [
              "adapter_verified",
              "kernel_verified",
              "engine_subset_verified",
              "adjudication_required",
              "blocked"
            ]
          },
          "pdf_pages": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "adapter_rule_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^dnd2024\\.[a-z0-9_.]+$"
      }
    },
    "external_dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unaccounted_bookmarks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_file",
        "text_sha256",
        "pdf_sha256",
        "toc_file",
        "visual_pages"
      ],
      "properties": {
        "text_file": {
          "type": "string",
          "minLength": 1
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "toc_file": {
          "type": "string",
          "minLength": 1
        },
        "visual_pages": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "classification_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "readiness_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "file",
          "rules",
          "status"
        ],
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "rules": {
            "type": "integer",
            "minimum": 1
          },
          "status": {
            "enum": [
              "saved_pending_targeted_tests",
              "targeted_tests_passed",
              "saved"
            ]
          }
        }
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pdf_page",
          "reason"
        ],
        "properties": {
          "pdf_page": {
            "type": "integer",
            "minimum": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "next": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_report": {
      "type": "string",
      "const": "reports/phb-01/summary.json"
    }
  }
}
