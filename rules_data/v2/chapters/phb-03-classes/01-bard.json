        {
          "op": "registered_procedure",
          "inputs": [],
          "constants": {
            "range_feet": 60,
            "max_dice_per_creature": 1,
            "bonus_action": true,
            "duration": "1 час",
            "uses": "модификатор Харизмы, минимум 1",
            "recharge": "Долгий отдых",
            "procedure_id": "bard_vardo_vdohnovenie"
          }
        }
      ],
      "semantic_questions": [
        "Какому существу в пределах 60 футов, которое видит или слышит Барда, Мастер подтверждает Кость бардовского вдохновения?"
      ],
      "facts": {
        "range_feet": 60,
        "max_dice_per_creature": 1,
        "bonus_action": true,
        "duration": "1 час",
        "uses": "модификатор Харизмы, минимум 1",
        "recharge": "Долгий отдых"
      },
      "rule_parameters": {
        "die_by_level": {
          "1": "к6",
          "5": "к8",
          "10": "к10",
          "15": "к12"
        }
      },
      "constraints": [],
      "exceptions": [],
      "duration": "per_action",
      "resources": [
        {
          "id": "bardic_inspiration_die",
          "handling": "dependency_not_extracted"
        }
      ],
      "source": {
        "document_id": "phb_2024_ru",
        "kind": "phb",
        "sha256": "40a8ea0225049902328fcc93aa79c14862a222148bb3bf76ce4ad5efbc8633a5",
        "publication_year": 2024,
        "pdf_page": 52,
        "printed_page": "51",
        "section": "Бард, глава 3 «Классы персонажей»: Бардовское вдохновение"
      },
      "verification": "source_checked_human_pending",
      "implementation": "existing_engine_subset",
      "auto_activate": false,
      "dependencies": [
        "phb2024.phb01.ability_modifier"
      ],
      "behavior_tests": [
        "phb03.bard.vardo_vdohnovenie",
        "nat20.class_features_reach_game.vardo_vdohnovenie"
      ],
      "readiness": {
        "status": "adjudication_required",
        "handler": "nat20_content.feature_gate",
        "scope": "Хост: вне боя кость не выдаётся, а в бою — союзнику в 60 футах и не в полном укрытии, кому выбирает игрок. Движок: эффект «Вдохновлён» на получателе, счётчик применений, кость берётся ЛЮБЫМ D20-тестом — атакой оружием, заклинательной атакой (по флагу интента) и спасброском (r177). Не закрыто: в кампании хоста в бою один герой, поэтому получателя кости нет и путь проверен на проекции двух героев; кость барда, вышедшего из боя, бросить нельзя",
        "blockers": [
          "в бою кампании хоста один герой — получателя кости нет; путь хоста готов и проверен на проекции двух героев"
        ]
      },
      "revision": 2
    },
