        },
        "xp_value": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Xp Value",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "monster",
        "position"
      ],
      "title": "PrototypeActor",
      "type": "object"
    },
