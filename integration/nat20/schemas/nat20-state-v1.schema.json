            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "id": {
          "default": "experimental",
          "title": "Id",
          "type": "string"
        },
        "prepared_spells": {
          "items": {
            "type": "string"
          },
          "maxItems": 100,
          "title": "Prepared Spells",
          "type": "array"
        },
        "rules_version": {
          "const": "dnd2024",
          "default": "dnd2024",
          "title": "Rules Version",
          "type": "string"
        },
        "schema_version": {
          "const": "nat20-experimental-v1",
          "default": "nat20-experimental-v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/CampaignSource"
        },
        "title": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "source",
