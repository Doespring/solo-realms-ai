            "$ref": "#/$defs/PrototypeCheck"
          },
          "maxProperties": 100,
          "title": "Checks",
          "type": "object"
        },
        "content_release": {
          "const": "prototype-srd-2024-v1",
          "default": "prototype-srd-2024-v1",
          "title": "Content Release",
          "type": "string"
        },
        "definition_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Definition Sha256",
          "type": "string"
        },
        "description": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "encounters": {
          "additionalProperties": {
            "$ref": "#/$defs/PrototypeEncounter"
          },
          "maxProperties": 64,
          "minProperties": 0,
          "title": "Encounters",
          "type": "object"
        },
        "features": {
